{
  "name": "flex-rate-limit",
  "version": "2.2.2",
  "description": "Universal rate limiting module for Node.js - supports any framework, multiple storage backends, flexible algorithms",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./index.mjs",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "index.d.ts",
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "throttle",
    "rate-limiting",
    "api-rate-limit",
    "express",
    "koa",
    "fastify",
    "hapi",
    "redis",
    "cache-hub",
    "atomic-state",
    "memory",
    "sliding-window",
    "token-bucket",
    "leaky-bucket",
    "distributed",
    "middleware",
    "framework-agnostic"
  ],
  "author": "vext.js Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vextjs/flex-rate-limit.git"
  },
  "bugs": {
    "url": "https://github.com/vextjs/flex-rate-limit/issues"
  },
  "homepage": "https://vextjs.github.io/flex-rate-limit",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "mocha test/**/*.test.js --timeout 5000 --exit",
    "test:unit": "mocha test/unit/**/*.test.js --exit",
    "test:integration": "mocha test/integration/**/*.test.js --timeout 5000 --exit",
    "test:all": "npm run test:unit && npm run test:integration",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=html npm test",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint lib/**/*.js test/**/*.js",
    "lint:fix": "eslint lib/**/*.js test/**/*.js --fix",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:preview": "npm --prefix website run preview",
    "benchmark:memory": "node scripts/benchmark-memory.js",
    "benchmark:redis": "node scripts/benchmark-redis.js",
    "benchmark:http": "node scripts/benchmark-http.js",
    "example:express": "node examples/express-example.js",
    "example:koa": "node examples/koa-example.js",
    "example:egg": "node examples/egg-example.js",
    "example:hapi": "node examples/hapi-example.js",
    "example:standalone": "node examples/standalone-example.js",
    "example:all": "npm run example:standalone"
  },
  "devDependencies": {
    "@types/node": "25.2.0",
    "autocannon": "8.0.0",
    "c8": "10.1.3",
    "chai": "4.5.0",
    "eslint": "8.57.1",
    "express": "4.22.2",
    "ioredis": "5.9.2",
    "koa": "2.16.4",
    "mocha": "10.8.2",
    "rate-limiter-flexible": "11.1.0",
    "redis-mock": "0.56.3",
    "sinon": "17.0.1",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "cache-hub": "2.1.0",
    "ioredis": "5.9.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
